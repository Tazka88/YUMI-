{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/brands/bestway",
      "destination": "/brands/piscines-bestway-algerie",
      "permanent": true
    },
    {
      "source": "/brands/hoco",
      "destination": "/brands/accessoires-hoco-algerie",
      "permanent": true
    },
    {
      "source": "/brands/kemei",
      "destination": "/brands/tondeuses-kemei-algerie",
      "permanent": true
    },
    {
      "source": "/brands/moulinex",
      "destination": "/brands/electromenager-moulinex-algerie",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api?seo=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?seo=robots"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
