{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/brands/bestway",
      "destination": "/brands/piscines-bestway-algerie",
      "permanent": true
    },
    {
      "source": "/brands/hoco",
      "destination": "/brands/accessoires-hoco-algerie",
      "permanent": true
    },
    {
      "source": "/brands/kemei",
      "destination": "/brands/tondeuses-kemei-algerie",
      "permanent": true
    },
    {
      "source": "/brands/moulinex",
      "destination": "/brands/electromenager-moulinex-algerie",
      "permanent": true
    },
    { "source": "/brands/philips", "destination": "/brands/electromenager-philips-algerie", "permanent": true },
    { "source": "/brands/robuste", "destination": "/brands/electromenager-robuste-algerie", "permanent": true },
    { "source": "/brands/sonashi", "destination": "/brands/electromenager-sonashi-algerie", "permanent": true },
    { "source": "/brands/anker", "destination": "/brands/accessoires-anker-algerie", "permanent": true },
    { "source": "/brands/enzo", "destination": "/brands/coiffure-enzo-algerie", "permanent": true },
    { "source": "/brands/karcher", "destination": "/brands/nettoyage-karcher-algerie", "permanent": true },
    { "source": "/brands/multismart", "destination": "/brands/electromenager-multismart-algerie", "permanent": true },
    { "source": "/brands/nespresso", "destination": "/brands/cafe-nespresso-algerie", "permanent": true },
    { "source": "/brands/tefal", "destination": "/brands/cuisine-tefal-algerie", "permanent": true },
    { "source": "/brands/xiaomi", "destination": "/brands/smartphones-xiaomi-algerie", "permanent": true },
    { "source": "/brands/bosch", "destination": "/brands/electromenager-bosch-algerie", "permanent": true },
    { "source": "/brands/calor", "destination": "/brands/entretien-calor-algerie", "permanent": true },
    { "source": "/brands/apple", "destination": "/brands/apple-algerie", "permanent": true },
    { "source": "/brands/brandman", "destination": "/brands/electromenager-brandman-algerie", "permanent": true },
    { "source": "/brands/ninja", "destination": "/brands/cuisine-ninja-algerie", "permanent": true },
    { "source": "/brands/remington", "destination": "/brands/beaute-remington-algerie", "permanent": true },
    { "source": "/brands/huawei", "destination": "/brands/high-tech-huawei-algerie", "permanent": true },
    { "source": "/brands/crown", "destination": "/brands/outillage-crown-algerie", "permanent": true },
    { "source": "/brands/silvercrest", "destination": "/brands/electromenager-silvercrest-algerie", "permanent": true },
    { "source": "/brands/seb", "destination": "/brands/electromenager-seb-algerie", "permanent": true },
    { "source": "/brands/uniross", "destination": "/brands/piles-uniross-algerie", "permanent": true },
    { "source": "/brands/tirex", "destination": "/brands/electromenager-tirex-algerie", "permanent": true },
    { "source": "/brands/sony", "destination": "/brands/high-tech-sony-algerie", "permanent": true },
    { "source": "/brands/delonghi", "destination": "/brands/cafe-delonghi-algerie", "permanent": true },
    { "source": "/brands/elite99", "destination": "/brands/electromenager-elite99-algerie", "permanent": true },
    { "source": "/brands/kenwood", "destination": "/brands/cuisine-kenwood-algerie", "permanent": true },
    { "source": "/brands/revlon", "destination": "/brands/beaute-revlon-algerie", "permanent": true },
    { "source": "/brands/samsung", "destination": "/brands/high-tech-samsung-algerie", "permanent": true },
    { "source": "/brands/realme", "destination": "/brands/high-tech-realme-algerie", "permanent": true },
    { "source": "/brands/proficook", "destination": "/brands/cuisine-proficook-algerie", "permanent": true },
    { "source": "/brands/nardi", "destination": "/brands/electromenager-nardi-algerie", "permanent": true },
    { "source": "/brands/nike", "destination": "/brands/mode-nike-algerie", "permanent": true },
    { "source": "/brands/lg", "destination": "/brands/high-tech-lg-algerie", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api?seo=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?seo=robots"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
